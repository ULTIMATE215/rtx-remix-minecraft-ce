{
    "schemaVersion": 1,
    "id": "rtx-remix-renderer",
    "version": "${version}",
    "name": "RTX Remix for Minecraft Community Edition (Unofficial)",
    "description": "Unofficial community edition of NVIDIA's RTX Remix for Minecraft (github.com/NVIDIAGameWorks/rtx-remix-minecraft), with lighting, weather, water, night sky, and motion blur improvements. Not affiliated with or endorsed by NVIDIA. NOT AN OFFICIAL MINECRAFT PRODUCT. NOT APPROVED BY OR ASSOCIATED WITH MOJANG OR MICROSOFT.",
    "authors": [
        "NVIDIA"
    ],
    "contributors": [
        "RTX Remix for Minecraft Community Edition contributors"
    ],
    "contact": {
        "homepage": "https://github.com/CuteEthanLeo/rtx-remix-minecraft-ce",
        "sources": "https://github.com/CuteEthanLeo/rtx-remix-minecraft-ce",
        "issues": "https://github.com/CuteEthanLeo/rtx-remix-minecraft-ce/issues"
    },
    "license": "Apache-2.0",
    "environment": "*",
    "entrypoints": {
        "preLaunch": [
            "com.nvidia.rtxremix.minecraft.RtssHookBlock",
            "com.nvidia.rtxremix.minecraft.WorkerPoolCap",
            "com.nvidia.rtxremix.minecraft.vulkan.VulkanBootstrap"
        ],
        "main": [
            "com.nvidia.rtxremix.minecraft.RtxRemixCommonMod"
        ],
        "client": [
            "com.nvidia.rtxremix.minecraft.RtxRemixMod"
        ]
    },
    "mixins": [
        "rtx-remix-renderer.mixins.json"
    ],
    "accessWidener": "rtx-remix-renderer.accesswidener",
    "depends": {
        "fabricloader": ">=0.20.1",
        "fabric-api": ">=0.161.0+26.2",
        "minecraft": "26.2",
        "java": ">=25"
    }
}
